{
  "manifest_version": 3,
  "name": "Typing Dynamics Collector",
  "version": "1.0.0",
  "description": "Records raw keystroke events (down/up) on selected websites for a keystroke dynamics project. 100% local data.",
  "permissions": ["storage", "unlimitedStorage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Typing Collector" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
